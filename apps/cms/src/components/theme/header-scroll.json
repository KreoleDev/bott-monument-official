{
  "collectionName": "components_theme_header_scroll",
  "info": {
    "displayName": "Header Color Rule",
    "description": "Add a rule per section. The first enabled matching rule wins; other sections use the normal header colors."
  },
  "attributes": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "section": {
      "type": "enumeration",
      "enum": [
        "hero",
        "marqueeStrip",
        "founder",
        "work",
        "press-clippings",
        "gallery",
        "showroom",
        "testimonials",
        "contact",
        "footer"
      ],
      "default": "work",
      "required": true
    },
    "backgroundColor": {
      "type": "string",
      "regex": "^#[0-9a-fA-F]{6}$",
      "default": "#0A0A0A"
    },
    "textColor": {
      "type": "string",
      "regex": "^#[0-9a-fA-F]{6}$",
      "default": "#F5F5F0"
    }
  }
}
