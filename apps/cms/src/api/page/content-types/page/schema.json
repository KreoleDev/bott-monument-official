{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Hero and Footer are fixed fields. Arrange the middle sections in content."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "pages.hero",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footer": {
      "type": "component",
      "repeatable": false,
      "component": "footer.details",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "pages.marquee",
        "pages.founder",
        "pages.news",
        "pages.featured-in",
        "pages.gallery",
        "pages.showroom",
        "pages.testimonials",
        "pages.contact"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "header": {
      "type": "component",
      "repeatable": false,
      "component": "pages.header",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
