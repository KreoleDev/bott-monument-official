{
  "kind": "collectionType",
  "collectionName": "private_gallery_items",
  "info": {
    "singularName": "private-gallery-item",
    "pluralName": "private-gallery-items",
    "displayName": "Gallery Image"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "caption": {
      "type": "text",
      "maxLength": 1000
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"],
      "description": "Upload an image file from your computer. It will be stored in the Strapi media library."
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::private-gallery-category.private-gallery-category",
      "inversedBy": "images",
      "required": true,
      "description": "Select an existing category. Create categories in Gallery Category before adding images."
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
