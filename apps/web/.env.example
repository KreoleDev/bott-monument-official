# Server-only CMS URL and read-only content token
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=
# Custom Strapi token with only api::inquiry.inquiry.create permission
STRAPI_INQUIRY_TOKEN=

# Preview and refresh secrets: use matching values in Strapi, never NEXT_PUBLIC_
PREVIEW_SECRET=
REVALIDATION_SECRET=
# Optional separate read token for preview; otherwise the read-only token is used
STRAPI_PREVIEW_TOKEN=
# Comma-separated PUBLIC image origins (e.g. https://media.example.com)
MEDIA_ORIGINS=
# NEXT_DIST_DIR=.next-build  # isolated build output during local validation
